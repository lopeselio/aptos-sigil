# Copy to `.env.local` (gitignored) and restart `npm run dev`.

NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_SIGIL_MODULE_ADDRESS=0x694fd0c04ecf4ec750450d3c1a4d318d5869f2cf762562a8a586a44e1c29d1c1
# Idle is game 2 (games: 0=arcade, 1=dungeon, 2=idle).
NEXT_PUBLIC_ARCADE_GAME_ID=2
NEXT_PUBLIC_SPONSOR_ENDPOINT=/api/sponsor

# Server-only secret: funded fee-payer key for ⚡ gasless (see arcade README / DEPLOYMENT_TESTNET.md).
SPONSOR_PRIVATE_KEY=
