# Copy to `.env.local` (gitignored) and restart `npm run dev`.

NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_SIGIL_MODULE_ADDRESS=0x568721f98162f03aa564384f15d7ead24b9825a3f35e4c2dba8265bd126ce787
# Dungeon is game 1 (the deploy + setup registered games 0=arcade, 1=dungeon, 2=idle).
NEXT_PUBLIC_ARCADE_GAME_ID=1
NEXT_PUBLIC_SPONSOR_ENDPOINT=/api/sponsor

# Server-only secret: funded fee-payer key for ⚡ gasless (see arcade README / DEPLOYMENT_TESTNET.md).
SPONSOR_PRIVATE_KEY=
