# Copy to `.env.local` (gitignored) and restart `npm run dev`.

# ---- Public (browser-exposed via NEXT_PUBLIC_) ----
NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_SIGIL_MODULE_ADDRESS=0x694fd0c04ecf4ec750450d3c1a4d318d5869f2cf762562a8a586a44e1c29d1c1
# Game id registered for the arcade (deploy script registers game 0).
NEXT_PUBLIC_ARCADE_GAME_ID=0
# Gas-station route used by the gasless submit (same-origin by default).
NEXT_PUBLIC_SPONSOR_ENDPOINT=/api/sponsor

# ---- Server-only secret (DO NOT prefix with NEXT_PUBLIC, never commit) ----
# The fee payer that sponsors gas for players. Use a FUNDED testnet account's
# private key (AIP-80 `ed25519-priv-0x…` or raw `0x…`). For the demo this is the
# `testnet-sponsor` profile in move/.aptos/config.yaml. Swap in your own to
# sponsor for your own app.
SPONSOR_PRIVATE_KEY=
# Optional: override the module the gas station will sponsor (defaults to the
# public module address above). Only functions under this address are paid for.
# SIGIL_MODULE_ADDRESS=
