{
  "name": "@sigil-aptos/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Sigil gaming platform on Aptos — scores, leaderboards, achievements, rewards, quests, seasons, guilds, and gasless (sponsored) transactions.",
  "type": "module",
  "license": "MIT",
  "author": "lopeselio",
  "homepage": "https://github.com/lopeselio/aptos-sigil/tree/master/sdk/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopeselio/aptos-sigil.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/lopeselio/aptos-sigil/issues"
  },
  "keywords": [
    "aptos",
    "move",
    "blockchain",
    "gaming",
    "leaderboard",
    "achievements",
    "sponsored-transactions",
    "fee-payer",
    "gasless",
    "web3",
    "sdk"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "example:deeper-smoke": "npx tsx examples/deeper-smoke.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": ">=6.0.0 <7"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
